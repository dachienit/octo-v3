{
	"name": "@octo/core-agent",
	"version": "0.0.1",
	"description": "Core agent — session management, agentic loop, and primitive tools",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./web": {
			"import": "./dist/web.js",
			"types": "./dist/web.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
