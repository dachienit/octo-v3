# LLM configuration
# Provider name - must match a known provider in @earendil-works/pi-ai
# Examples: openai, anthropic, openrouter, groq, openai-codex
LLM_PROVIDER=openai

# Model ID for the chosen provider
LLM_MODEL=gpt-4o-mini

# ChatGPT Codex OAuth provider:
#   1. Start core-service with:
#      LLM_PROVIDER=openai-codex
#      LLM_MODEL=gpt-5.4
#   2. Sign in to the web app, then run Codex login from that user session.
#      Each core-service user gets a separate auth file under:
#      {core-service data root}/users/{user-id}/auth.json

# Disable new account signup after the first local user exists.
# CORE_SERVICE_ALLOW_SIGNUP=false

# Custom API base URL - use this for OpenAI-compatible endpoints:
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://localhost:8000/v1
#   OpenRouter: https://openrouter.ai/api/v1
# LLM_BASE_URL=http://localhost:11434/v1

# API key - alternative to storing in ~/.pi/mom/auth.json
# LLM_API_KEY=sk-...

# Core service port (default: 3030)
# PORT=3030

# Managed Docker/Podman workspace sandbox cleanup.
# Only applies to --sandbox=docker or --sandbox=podman managed mode.
# Set idle ms <= 0 to disable cleanup.
# CORE_SERVICE_SANDBOX_IDLE_MS=1800000
# CORE_SERVICE_SANDBOX_CLEANUP_INTERVAL_MS=60000

# SAP AI Core custom provider extension
# AICORE_SERVICE_KEY={"serviceurls":{"AI_API_URL":"https://..."},"clientid":"...","clientsecret":"...","url":"https://..."}
# SAP_AI_RESOURCE_GROUP=default
# SAP_AI_CORE_API_KEY=...
# SAP_AI_OPENAI_MODEL=gpt-4.1
# SAP_AI_CLAUDE_MODEL=claude-sonnet-4-5

# Agent delegation
# Set to false/0/off/no to hide and disable agent worker delegation.
# CORE_SERVICE_AGENT_WORKERS_ENABLED=true
# Set to false/0/off/no to hide and disable scheduled reminders/events.
# CORE_SERVICE_REMINDERS_ENABLED=true
# Mom exposes agent worker tools. Worker agents run on the host
# and receive the same shared artifacts workspace as their cwd.
# Override commands/args for the agent CLIs you have installed:
# ACP_CODEX_MODEL=gpt-5.4-mini[medium]
# ACP_CODEX_MODE=agent-full-access
# ACP_AGENTS_JSON={"codex":{"command":"codex-acp"},"gemini":{"command":"gemini","args":["--acp"]},"claude":{"command":"npx","args":["-y","@agentclientprotocol/claude-agent-acp"]}}
