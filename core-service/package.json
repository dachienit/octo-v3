{
	"name": "@octo/core-service",
	"version": "0.0.1",
	"description": "Octo core service",
	"type": "module",
	"bin": {
		"octo": "dist/main.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"templates"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"start:http": "node dist/main.js --http ../workspace",
		"dev:http": "tsgo -p tsconfig.build.json && node dist/main.js --http ../workspace",
		"dev:http:debug": "tsgo -p tsconfig.build.json && node --inspect dist/main.js --http ../workspace",
		"dev:http:docker": "tsgo -p tsconfig.build.json && node dist/main.js --http --sandbox=docker:octo-sandbox ../workspace",
		"dev:http:docker:managed": "tsgo -p tsconfig.build.json && node dist/main.js --http --sandbox=docker ../workspace",
		"dev:http:podman": "tsgo -p tsconfig.build.json && node dist/main.js --http --sandbox=podman:octo-sandbox ../workspace",
		"dev:http:podman:managed": "tsgo -p tsconfig.build.json && node dist/main.js --http --sandbox=podman ../workspace",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@aws-sdk/client-bedrock-runtime": "^3.1050.0",
		"@aws-sdk/client-s3": "^3.1050.0",
		"@octo/core-agent": "*",
		"adt-cli": "file:../../adt-cli",
		"@radix-ui/react-dropdown-menu": "^2.1.18",
		"@radix-ui/react-scroll-area": "^1.2.12",
		"@radix-ui/react-select": "^2.3.1",
		"@radix-ui/react-separator": "^1.1.10",
		"@radix-ui/react-slot": "^1.3.0",
		"@radix-ui/react-tabs": "^1.1.15",
		"@radix-ui/react-tooltip": "^1.2.10",
		"@sap/xsenv": "^5.6.0",
		"@sap/xssec": "^4.8.0",
		"@slack/socket-mode": "^2.0.0",
		"@slack/web-api": "^7.0.0",
		"chalk": "^5.6.2",
		"clsx": "^2.1.1",
		"croner": "^9.1.0",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"jszip": "^3.10.1",
		"lucide-react": "^1.21.0",
		"mammoth": "^1.12.0",
		"passport": "^0.7.0",
		"passport-local": "^1.0.0",
		"pg": "^8.13.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwind-merge": "^3.6.0",
		"undici": "^8.4.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.2",
		"@types/passport": "^1.0.17",
		"@types/passport-local": "^1.0.38",
		"@types/pg": "^8.11.10",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260120.1",
		"typescript": "^5.7.3"
	},
	"keywords": [
		"bot",
		"ai",
		"agent"
	],
	"license": "UNLICENSED",
	"engines": {
		"node": ">=20.0.0"
	}
}
